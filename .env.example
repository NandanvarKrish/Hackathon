# EchoNote AI Environment Variables & Production Deployment Configuration

# ------------------------------------------------------------------------------
# 1. OPTION A: SECURE BACKEND / SERVERLESS DEPLOYMENT (RECOMMENDED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Set this secret in your deployment dashboard (Vercel, Netlify, Render, Cloudflare).
# The client bundle will proxy requests via /api/gemini without exposing your secret.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. OPTION B: CLIENT-SIDE VITE ENVIRONMENT VARIABLE (LOCAL DEV / STATIC HOSTING)
# ------------------------------------------------------------------------------
# If deploying as a pure static site (e.g. GitHub Pages) without serverless functions,
# you can specify VITE_GEMINI_API_KEY here.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
